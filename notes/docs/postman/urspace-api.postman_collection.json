{
  "info": {
    "name": "UrSpace API (v1)",
    "description": "Implemented API surface for UrSpace. Auth: the login flow is unchanged and has no API endpoint. Use a Supabase session cookie copied from the browser, or run \"Auth / Get Supabase token\" with a dedicated test account. Never use the service-role key. See docs/POSTMAN.md for which cases are verified.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "supabaseUrl",
      "value": "https://YOUR-PROJECT-REF.supabase.co",
      "type": "string"
    },
    {
      "key": "supabasePublishableKey",
      "value": "YOUR-PUBLISHABLE-KEY",
      "type": "string"
    },
    {
      "key": "email",
      "value": "api-test@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "REPLACE-ME",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "noteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "tutorId",
      "value": "",
      "type": "string"
    },
    {
      "key": "unknownId",
      "value": "00000000-0000-4000-8000-000000000000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Public",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('ok', () => pm.expect(pm.response.json().data.status).to.eql('ok'));",
                  "pm.test('no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Public settings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); pm.test('data envelope', () => pm.expect(b).to.have.property('data'));",
                  "const d = pm.response.json().data; pm.test('settings shape', () => pm.expect(d).to.include.keys('allowPublicSignup','platformNotice'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "public",
                "settings"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Supabase token (transitional)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p = pm.response.json();",
                  "pm.test('token returned', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', p.access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabasePublishableKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
              "host": [
                "{{supabaseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Only for Postman/scripts. The browser login flow does not use this endpoint."
          },
          "response": []
        },
        {
          "name": "Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json(); pm.test('data envelope', () => pm.expect(b).to.have.property('data'));",
                  "const d = pm.response.json().data; pm.test('session shape', () => pm.expect(d).to.include.keys('user','profile','via'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "session"
              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
