# Supabase → Project Settings → API Keys
# Use the publishable key only. Never put a service-role/secret key in a
# NEXT_PUBLIC_ variable — it would be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by admin/owner account management (Supabase Admin API).
# NEVER prefix this with NEXT_PUBLIC_ and never import it into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Supabase personal access token (Account → Access Tokens), used
# once to apply db/schema.sql via the Management API. Not a project API key.
# NEVER prefix this with NEXT_PUBLIC_ and never import it into client code.
SUPABASE_ACCESS_TOKEN=